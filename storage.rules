rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Match AuthService.uploadProfilePhoto's exact uid.jpg filename.
    match /profile_photos/{fileName} {
      allow read:  if request.auth != null;
      allow create, update: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // Audio assets
    match /audio/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Lecture video assets
    match /lectures/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

  }
}
