rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : 'devotee';
    }
    
    function isAdmin() {
      return isActiveUser() && getRole() == 'admin';
    }
    
    function isCounselor() {
      return isActiveUser() && getRole() == 'counselor';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isActiveUser() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(path) && get(path).data.status == 'active';
    }

    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    // Users collection
    match /users/{uid} {
      // Any authenticated user can read their own doc
      // Admins can read anyone
      // Counselors can read docs where counselorUid == their UID (supports .where() queries)
      allow get: if isAuthenticated() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (isCounselor() && resource.data.counselorUid == request.auth.uid)
      );
      // Counselors must query only their assigned users; rules are not filters.
      allow list: if isAdmin() ||
        (isCounselor() && resource.data.counselorUid == request.auth.uid);
      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == 'student' &&
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny(['counselorUid', 'assignedDevotees', 'attendanceScore']);
      allow update: if isAuthenticated() && (
        (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'rollNumber', 'phoneNumber', 'profilePhotoUrl', 'fcmToken',
          'updatedAt', 'address', 'dateOfBirth', 'collegeBranch', 'year', 'interests', 'skills'
        ]))
        || (isCounselor() && resource.data.counselorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendanceScore']) &&
          request.resource.data.attendanceScore is int)
        || isAdmin()
      );
      allow delete: if false;
    }

    // Preaching Sessions
    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Preaching Attendance
    match /attendance/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isCounselor() &&
        get(/databases/$(database)/documents/users/$(request.resource.data.devoteeId)).data.counselorUid == request.auth.uid &&
        request.resource.data.markedBy == request.auth.uid);
      allow update: if isAdmin() || (isCounselor() &&
        get(/databases/$(database)/documents/users/$(resource.data.devoteeId)).data.counselorUid == request.auth.uid &&
        request.resource.data.devoteeId == resource.data.devoteeId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.markedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Legacy Attendance Sessions (admin attendance management)
    match /attendance_sessions/{sessionId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Legacy Attendance Records (admin attendance management)
    match /attendance_records/{recordId} {
      allow read: if isActiveUser();
      allow create: if isAdmin() &&
        !get(/databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)).data.isLocked;
      allow update: if isAdmin() &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.studentUid == resource.data.studentUid &&
        !get(/databases/$(database)/documents/attendance_sessions/$(resource.data.sessionId)).data.isLocked;
      allow delete: if false;
    }

    // Lectures
    match /lectures/{lectureId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Audio Tracks
    match /audio_tracks/{trackId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Japa Logs (per user)
    match /japa_logs/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Collection-group query on 'logs' sub-collection — admin only (for stats)
    match /{path=**}/logs/{logId} {
      allow read: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isActiveUser();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // Assignment Submissions
    match /assignment_submissions/{submissionId} {
      allow read: if isAdmin() || (isActiveUser() && resource.data.studentUid == request.auth.uid);
      allow create: if isActiveUser() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
